{
  "_meta": {
    "id": "app-chrome",
    "name": "App - Google Chrome",
    "description": "Chrome Enterprise x64 MSI, silent install, file version detection",
    "type": "win32app"
  },
  "displayName": "Google Chrome",
  "publisher": "Google",
  "installerType": "msi",
  "sourceUrl": "https://chromeenterprise.google/browser/download/",
  "installCommandLine": "msiexec /i googlechromestandaloneenterprise64.msi /qn /norestart",
  "uninstallCommandLine": "msiexec /x {PRODUCT-CODE} /qn /norestart",
  "installExperience": "system",
  "detectionRules": [
    {
      "ruleType": "file",
      "path": "%ProgramFiles%\\Google\\Chrome\\Application",
      "fileOrFolderName": "chrome.exe",
      "detectionType": "exists"
    }
  ],
  "requirements": {
    "architecture": "x64",
    "minimumOs": "W10_1903"
  },
  "returnCodes": [
    { "code": 0, "type": "success" },
    { "code": 3010, "type": "softReboot" }
  ]
}
