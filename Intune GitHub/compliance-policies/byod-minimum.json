{
  "_meta": {
    "id": "cp-byod-minimum",
    "name": "Compliance - BYOD Minimum",
    "description": "Looser bar for personal devices: encryption, AV, password, no jailbreak-tier checks",
    "type": "compliance"
  },
  "@odata.type": "#microsoft.graph.windows10CompliancePolicy",
  "displayName": "Compliance - BYOD Minimum",
  "description": "Minimum bar for personally owned Windows devices accessing corp data.",
  "bitLockerEnabled": false,
  "defenderEnabled": true,
  "rtpEnabled": true,
  "antivirusRequired": true,
  "osMinimumVersion": "10.0.19045.0",
  "passwordRequired": true,
  "passwordBlockSimple": true,
  "passwordMinimumLength": 6,
  "passwordRequiredType": "deviceDefault",
  "storageRequireEncryption": true,
  "scheduledActionsForRule": [
    {
      "ruleName": "PasswordRequired",
      "scheduledActionConfigurations": [
        {
          "actionType": "block",
          "gracePeriodHours": 168,
          "notificationTemplateId": ""
        }
      ]
    }
  ]
}
